{
  "manifest_version": 3,
  "name": "ClipConvo",
  "version": "0.1.0",
  "description": "Ask questions about YouTube videos using AI",

  "permissions": ["activeTab", "storage", "scripting"],

  "host_permissions": ["*://*.youtube.com/*", "http://localhost:8000/*"],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/watch*"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "ClipConvo",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "web_accessible_resources": [
    {
      "resources": ["src/utils/seek_bridge_injected.js"],
      "matches": ["*://*.youtube.com/*"]
    }
  ]
}
