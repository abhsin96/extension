{
  "name": "youtube-extention",
  "version": "0.1.0",
  "description": "YouTube video Q&A Chrome Extension",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/ __tests__/",
    "format:check": "prettier --check src/ __tests__/",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "build": "node build.js",
    "build:watch": "node build.js --watch",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "lint:ext": "node scripts/validate-manifest.js",
    "generate-icons": "node scripts/generate-icons.js",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{js,ts}": [
      "prettier --write"
    ],
    "__tests__/**/*.{js,ts}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/chrome": "^0.1.42",
    "@vitest/coverage-v8": "^2.0.0",
    "esbuild": "^0.23.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "husky": "^9.0.0",
    "jsdom": "^24.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript": "^6.0.3",
    "vitest": "^2.0.0",
    "web-ext": "^8.0.0"
  }
}
